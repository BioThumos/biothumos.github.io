filters:
  and:
    - file.folder == this.file.folder
    - file.ext == "md"
    - tracked == true
views:
  - type: table
    name: Bayer
    filters:
      and:
        - provenance == "pbayer"
    order:
      - file.name
      - category
      - provenance
      - status
      - file.mtime
    sort:
      - property: category
        direction: ASC
  - type: table
    name: Membrane
    filters:
      and:
        - category == "membrane"
    order:
      - file.name
      - category
      - provenance
      - status
      - file.mtime
    sort:
      - property: category
        direction: ASC
  - type: table
    name: Jard
    filters:
      and:
        - provenance == "jard"
        - or:
            - category == "antiviral"
            - category == "immune"
    order:
      - file.name
      - category
      - provenance
      - status
      - file.mtime
    sort:
      - property: category
        direction: ASC
  - type: table
    name: All
    order:
      - file.name
      - category
      - provenance
      - status
      - file.mtime
    sort:
      - property: status
        direction: DESC
      - property: provenance
        direction: DESC
      - property: category
        direction: DESC
      - property: file.name
        direction: ASC
  - type: table
    name: Research
    filters:
      and:
        - status == "research"
    order:
      - file.name
      - category
      - provenance
      - status
      - file.mtime
    sort:
      - property: status
        direction: ASC
      - property: category
        direction: ASC
  - type: table
    name: Order
    filters:
      and:
        - status == "order"
    order:
      - file.name
      - category
      - provenance
      - status
      - file.mtime
    sort:
      - property: status
        direction: ASC
      - property: category
        direction: ASC
